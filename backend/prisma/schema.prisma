generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth & Access ───────────────────────────────────────────────

enum SystemRole {
  CON_MANAGER
  DEPARTMENT_LEAD
  VOLUNTEER
  GUEST
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         SystemRole @default(VOLUNTEER)
  isActive     Boolean    @default(true)
  phone        String?
  title        String?
  avatarUrl    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  policyAssignments   AccessPolicyAssignment[]
  departmentMembers   DepartmentMember[]
  invitesSent         Invite[]                 @relation("InvitesSent")
  passwordResets      PasswordResetToken[]
  todosCreated        Todo[]                   @relation("TodosCreated")
  todosAssigned       Todo[]                   @relation("TodosAssigned")
  communicationsSent  Communication[]          @relation("CommsSent")
  communicationReads  CommunicationRead[]
  helpdeskCreated     HelpdeskTicket[]         @relation("TicketsCreated")
  helpdeskAssigned    HelpdeskTicket[]         @relation("TicketsAssigned")
  helpdeskComments    HelpdeskComment[]
  calendarEvents      CalendarEvent[]          @relation("EventsOwned")
  calendarOverlays    CalendarOverlayRequest[] @relation("OverlayRequester")
  calendarTargets     CalendarOverlayRequest[] @relation("OverlayTarget")
  documentsUploaded   Document[]               @relation("DocsUploaded")
  documentRevisions   DocumentRevision[]
  surveysCreated      Survey[]
  surveyResponses     SurveyResponse[]
  handoverNotes       HandoverNote[]
  shifts              ShiftAssignment[]
  inventoryLogs       InventoryLog[]
  orderRequests       ItemOrder[]              @relation("OrdersRequested")
  ordersFulfilled     ItemOrder[]              @relation("OrdersFulfilled")
  budgetEntries       BudgetEntry[]
  lostFoundItems      LostFoundItem[]
  mediaUploads        MediaItem[]
  biblePages          ConBiblePage[]
  orgNodes            OrgChartNode[]
  badgeAssignments    BadgeAssignment[]
  radioAssignments    RadioAssignment[]
  onCallSlots         OnCallSlot[]
  roomBookings        RoomBooking[]
  notifications       Notification[]

  @@index([role])
  @@index([isActive])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Invite {
  id           String     @id @default(cuid())
  email        String
  role         SystemRole @default(VOLUNTEER)
  departmentId String?
  tokenHash    String     @unique
  invitedById  String
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime   @default(now())

  invitedBy  User        @relation("InvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([departmentId])
}

/// Named reusable permission set
model AccessPolicy {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[] // Permission keys, e.g. "helpdesk.manage"
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments AccessPolicyAssignment[]
}

model AccessPolicyAssignment {
  id       String @id @default(cuid())
  userId   String
  policyId String

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  policy AccessPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([userId, policyId])
}

// ─── Settings & Feature Toggles ──────────────────────────────────

model AppSettings {
  id                    String   @id @default("default")
  conferenceName        String   @default("Conference")
  hotelSoloNightLimit   Int      @default(0)
  hotelRoommateNightLimit Int    @default(0)
  // SMTP
  smtpHost              String?
  smtpPort              Int      @default(587)
  smtpUser              String?
  smtpPassword          String?
  smtpFrom              String?
  smtpSecure            Boolean  @default(false)
  // Global feature toggles (JSON map of FeatureKey -> boolean)
  globalFeatures        Json     @default("{}")
  updatedAt             DateTime @updatedAt
}

// ─── Departments ─────────────────────────────────────────────────

model Department {
  id                   String   @id @default(cuid())
  name                 String   @unique
  description          String?
  color                String   @default("#6366f1")
  isOrderingDept       Boolean  @default(false)
  helpdeskQueueAccess  Boolean  @default(false)
  // Per-department feature toggles
  features             Json     @default("{}")
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  members          DepartmentMember[]
  invites          Invite[]
  todos            Todo[]
  communications   Communication[]
  tickets          HelpdeskTicket[]
  calendarEvents   CalendarEvent[]
  documents        Document[]
  surveys          Survey[]
  handoverNotes    HandoverNote[]
  shifts           Shift[]
  inventoryItems   InventoryItem[]
  ordersRequested  ItemOrder[]       @relation("OrderFromDept")
  ordersFulfilled  ItemOrder[]       @relation("OrderToDept")
  budgetEntries    BudgetEntry[]
  orgNodes         OrgChartNode[]
  radioChannels    RadioChannel[]
  onCallSlots      OnCallSlot[]
  runOfShowItems   RunOfShowItem[]
}

model DepartmentMember {
  id           String   @id @default(cuid())
  departmentId String
  userId       String
  isLead       Boolean  @default(false)
  createdAt    DateTime @default(now())

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([departmentId, userId])
  @@index([userId])
}

// ─── Todos ───────────────────────────────────────────────────────

enum TodoStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TodoPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Todo {
  id           String       @id @default(cuid())
  title        String
  description  String?
  status       TodoStatus   @default(OPEN)
  priority     TodoPriority @default(MEDIUM)
  dueAt        DateTime?
  departmentId String?
  createdById  String
  assigneeId   String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  department Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdBy  User        @relation("TodosCreated", fields: [createdById], references: [id], onDelete: Cascade)
  assignee   User?       @relation("TodosAssigned", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([departmentId])
  @@index([assigneeId])
  @@index([status])
}

// ─── Communications ──────────────────────────────────────────────

model Communication {
  id           String   @id @default(cuid())
  subject      String
  body         String
  departmentId String?
  authorId     String
  // empty = all in department (or broadcast if no dept)
  recipientIds String[]
  isPinned     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department?          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  author     User                 @relation("CommsSent", fields: [authorId], references: [id], onDelete: Cascade)
  reads      CommunicationRead[]

  @@index([departmentId])
  @@index([authorId])
}

model CommunicationRead {
  id              String   @id @default(cuid())
  communicationId String
  userId          String
  readAt          DateTime @default(now())

  communication Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communicationId, userId])
}

// ─── Helpdesk ────────────────────────────────────────────────────

enum TicketSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

model HelpdeskTicket {
  id               String         @id @default(cuid())
  title            String
  description      String
  severity         TicketSeverity @default(MEDIUM)
  status           TicketStatus   @default(OPEN)
  departmentId     String
  createdById      String
  assigneeId       String?
  escalatedToId    String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  resolvedAt       DateTime?

  department Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdBy  User              @relation("TicketsCreated", fields: [createdById], references: [id], onDelete: Cascade)
  assignee   User?             @relation("TicketsAssigned", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments   HelpdeskComment[]

  @@index([departmentId])
  @@index([status])
  @@index([severity])
}

model HelpdeskComment {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  body      String
  isInternal Boolean @default(false)
  createdAt DateTime @default(now())

  ticket HelpdeskTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User           @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

// ─── Calendar ────────────────────────────────────────────────────

model CalendarEvent {
  id           String   @id @default(cuid())
  title        String
  description  String?
  location     String?
  startsAt     DateTime
  endsAt       DateTime
  allDay       Boolean  @default(false)
  isMaster     Boolean  @default(false) // Con Manager master calendar
  color        String?
  departmentId String?
  ownerId      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  owner      User        @relation("EventsOwned", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([startsAt, endsAt])
  @@index([departmentId])
  @@index([ownerId])
  @@index([isMaster])
}

enum OverlayStatus {
  PENDING
  APPROVED
  DENIED
}

model CalendarOverlayRequest {
  id          String        @id @default(cuid())
  requesterId String
  targetId    String
  status      OverlayStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  requester User @relation("OverlayRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  target    User @relation("OverlayTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([requesterId, targetId])
}

// ─── Documents ───────────────────────────────────────────────────

enum DocumentSource {
  LOCAL
  EXTERNAL
}

model Document {
  id           String         @id @default(cuid())
  title        String
  description  String?
  departmentId String?
  source       DocumentSource @default(LOCAL)
  // current revision pointer fields (denormalized for list speed)
  currentUrl   String?
  currentPath  String?
  mimeType     String?
  sizeBytes    Int?
  uploadedById String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  department Department?        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  uploadedBy User               @relation("DocsUploaded", fields: [uploadedById], references: [id], onDelete: Cascade)
  revisions  DocumentRevision[]

  @@index([departmentId])
}

model DocumentRevision {
  id         String   @id @default(cuid())
  documentId String
  version    Int
  source     DocumentSource
  url        String?
  filePath   String?
  mimeType   String?
  sizeBytes  Int?
  notes      String?
  createdById String
  createdAt  DateTime @default(now())

  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([documentId])
}

// ─── Surveys ─────────────────────────────────────────────────────

model Survey {
  id           String   @id @default(cuid())
  title        String
  description  String?
  departmentId String?
  questions    Json     // [{id, type, label, required, options?}]
  isOpen       Boolean  @default(true)
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department?      @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdBy  User             @relation(fields: [createdById], references: [id], onDelete: Cascade)
  responses  SurveyResponse[]
}

model SurveyResponse {
  id        String   @id @default(cuid())
  surveyId  String
  userId    String
  answers   Json
  createdAt DateTime @default(now())

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([surveyId, userId])
}

// ─── Handover Notes ──────────────────────────────────────────────

model HandoverNote {
  id           String   @id @default(cuid())
  departmentId String
  authorId     String
  title        String
  body         String
  shiftLabel   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  author     User       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([departmentId])
}

// ─── Shifts ──────────────────────────────────────────────────────

model Shift {
  id           String   @id @default(cuid())
  departmentId String
  title        String
  description  String?
  startsAt     DateTime
  endsAt       DateTime
  location     String?
  slots        Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department  Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  assignments ShiftAssignment[]

  @@index([departmentId])
  @@index([startsAt])
}

model ShiftAssignment {
  id        String   @id @default(cuid())
  shiftId   String
  userId    String
  notes     String?
  createdAt DateTime @default(now())

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shiftId, userId])
}

// ─── Inventory / Assets ──────────────────────────────────────────

model InventoryItem {
  id           String   @id @default(cuid())
  departmentId String?
  name         String
  sku          String?
  description  String?
  quantity     Int      @default(0)
  location     String?
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  logs       InventoryLog[]

  @@index([departmentId])
  @@index([name])
}

model InventoryLog {
  id        String   @id @default(cuid())
  itemId    String
  userId    String
  delta     Int
  note      String?
  createdAt DateTime @default(now())

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Item Orders ─────────────────────────────────────────────────

enum OrderStatus {
  REQUESTED
  APPROVED
  FULFILLED
  DENIED
  CANCELLED
}

model ItemOrder {
  id              String      @id @default(cuid())
  title           String
  description     String?
  quantity        Int         @default(1)
  status          OrderStatus @default(REQUESTED)
  fromDeptId      String?
  toDeptId        String?
  requestedById   String
  fulfilledById   String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  fromDept    Department? @relation("OrderFromDept", fields: [fromDeptId], references: [id], onDelete: SetNull)
  toDept      Department? @relation("OrderToDept", fields: [toDeptId], references: [id], onDelete: SetNull)
  requestedBy User        @relation("OrdersRequested", fields: [requestedById], references: [id], onDelete: Cascade)
  fulfilledBy User?       @relation("OrdersFulfilled", fields: [fulfilledById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([toDeptId])
}

// ─── Budget ──────────────────────────────────────────────────────

model BudgetEntry {
  id           String   @id @default(cuid())
  departmentId String?
  label        String
  amount       Decimal  @db.Decimal(12, 2)
  category     String?
  notes        String?
  incurredAt   DateTime @default(now())
  createdById  String
  createdAt    DateTime @default(now())

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdBy  User        @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([departmentId])
}

// ─── Lost & Found ────────────────────────────────────────────────

enum LostFoundStatus {
  LOST
  FOUND
  CLAIMED
  DISPOSED
}

model LostFoundItem {
  id          String          @id @default(cuid())
  title       String
  description String?
  location    String?
  status      LostFoundStatus @default(FOUND)
  reportedById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  reportedBy User @relation(fields: [reportedById], references: [id], onDelete: Cascade)
}

// ─── Media Gallery ───────────────────────────────────────────────

model MediaItem {
  id          String   @id @default(cuid())
  title       String
  description String?
  url         String?
  filePath    String?
  mimeType    String?
  uploadedById String
  createdAt   DateTime @default(now())

  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
}

// ─── Con Bible ───────────────────────────────────────────────────

model ConBiblePage {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  body        String
  category    String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  authorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

// ─── Org Chart ───────────────────────────────────────────────────

model OrgChartNode {
  id           String  @id @default(cuid())
  title        String
  userId       String?
  departmentId String?
  parentId     String?
  sortOrder    Int     @default(0)

  user       User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  department Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  parent     OrgChartNode? @relation("OrgTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   OrgChartNode[] @relation("OrgTree")
}

// ─── Badge System ────────────────────────────────────────────────

model BadgeType {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  color       String  @default("#0ea5e9")

  assignments BadgeAssignment[]
}

model BadgeAssignment {
  id         String   @id @default(cuid())
  badgeTypeId String
  userId     String
  notes      String?
  createdAt  DateTime @default(now())

  badgeType BadgeType @relation(fields: [badgeTypeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([badgeTypeId, userId])
}

// ─── Radio Channels ──────────────────────────────────────────────

model RadioChannel {
  id           String  @id @default(cuid())
  name         String
  frequency    String?
  description  String?
  departmentId String?

  department  Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignments RadioAssignment[]
}

model RadioAssignment {
  id        String   @id @default(cuid())
  channelId String
  userId    String
  callSign  String?
  createdAt DateTime @default(now())

  channel RadioChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
}

// ─── On-Call Roster ──────────────────────────────────────────────

model OnCallSlot {
  id           String   @id @default(cuid())
  departmentId String?
  userId       String
  startsAt     DateTime
  endsAt       DateTime
  notes        String?
  createdAt    DateTime @default(now())

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([startsAt, endsAt])
}

// ─── Room Booking ────────────────────────────────────────────────

enum RoomBookingStatus {
  REQUESTED
  APPROVED
  DENIED
  CANCELLED
}

model Room {
  id       String  @id @default(cuid())
  name     String  @unique
  capacity Int?
  location String?
  notes    String?

  bookings RoomBooking[]
}

model RoomBooking {
  id          String            @id @default(cuid())
  roomId      String
  userId      String
  title       String
  startsAt    DateTime
  endsAt      DateTime
  status      RoomBookingStatus @default(REQUESTED)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId, startsAt, endsAt])
}

// ─── Run of Show ─────────────────────────────────────────────────

model RunOfShowItem {
  id           String   @id @default(cuid())
  departmentId String?
  title        String
  description  String?
  startsAt     DateTime
  endsAt       DateTime?
  location     String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([startsAt])
}

// ─── Notifications ───────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}
