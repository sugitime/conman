generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth & Access ───────────────────────────────────────────────

enum SystemRole {
  CON_MANAGER
  DEPARTMENT_LEAD
  VOLUNTEER
  GUEST
}

enum ShirtSize {
  XS
  S
  M
  L
  XL
  XXL
  XXXL
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         SystemRole @default(VOLUNTEER)
  isActive     Boolean    @default(true)
  phone        String?
  title        String?
  pronouns     String?
  avatarUrl    String?

  // Volunteer / staff profile
  hotelCheckIn    DateTime?
  hotelCheckOut   DateTime?
  roommateId      String?
  shirtSize       ShirtSize?
  emergencyName   String?
  emergencyPhone  String?
  dietaryNotes    String? // privacy-controlled
  medicalNotes    String? // privacy-controlled
  profileComplete Boolean   @default(false)
  hotelCompliant  Boolean   @default(true)
  hotelWarning    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roommate            User?  @relation("Roommates", fields: [roommateId], references: [id], onDelete: SetNull)
  roommatesOf         User[] @relation("Roommates")

  policyAssignments   AccessPolicyAssignment[]
  departmentMembers   DepartmentMember[]
  invitesSent         Invite[]                 @relation("InvitesSent")
  passwordResets      PasswordResetToken[]
  todosCreated        Todo[]                   @relation("TodosCreated")
  todosAssigned       Todo[]                   @relation("TodosAssigned")
  communicationsSent  Communication[]          @relation("CommsSent")
  communicationReads  CommunicationRead[]
  helpdeskCreated     HelpdeskTicket[]         @relation("TicketsCreated")
  helpdeskAssigned    HelpdeskTicket[]         @relation("TicketsAssigned")
  helpdeskComments    HelpdeskComment[]
  calendarEvents      CalendarEvent[]          @relation("EventsOwned")
  calendarOverlays    CalendarOverlayRequest[] @relation("OverlayRequester")
  calendarTargets     CalendarOverlayRequest[] @relation("OverlayTarget")
  documentsUploaded   Document[]               @relation("DocsUploaded")
  documentRevisions   DocumentRevision[]
  surveysCreated      Survey[]
  surveyResponses     SurveyResponse[]
  handoverNotes       HandoverNote[]
  shifts              ShiftAssignment[]
  inventoryLogs       InventoryEvent[]         @relation("InventoryActor")
  checkedOutItems     InventoryItem[]          @relation("CheckedOutTo")
  orderRequests       ItemOrder[]              @relation("OrdersRequested")
  ordersFulfilled     ItemOrder[]              @relation("OrdersFulfilled")
  budgetEntries       BudgetEntry[]            @relation("BudgetCreated")
  budgetApprovals     BudgetEntry[]            @relation("BudgetApproved")
  lostFoundItems      LostFoundItem[]
  mediaUploads        MediaItem[]
  biblePages          ConBiblePage[]
  orgNodes            OrgChartNode[]
  badgeAssignments    BadgeAssignment[]
  radioAssignments    RadioAssignment[]
  onCallSlots         OnCallSlot[]
  roomBookings        RoomBooking[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  staffCheckIns       StaffCheckIn[]
  mealSelections      MealSelection[]
  vendorsManaged      Vendor[]                 @relation("VendorContact")
  loadTasksCreated    LoadScheduleTask[]       @relation("LoadTasksCreated")
  loadTasksAssigned   LoadScheduleTask[]       @relation("LoadTasksAssigned")

  @@index([role])
  @@index([isActive])
  @@index([roommateId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Invite {
  id           String     @id @default(cuid())
  email        String
  role         SystemRole @default(VOLUNTEER)
  departmentId String?
  tokenHash    String     @unique
  invitedById  String
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime   @default(now())

  invitedBy  User        @relation("InvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([departmentId])
}

model AccessPolicy {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments AccessPolicyAssignment[]
}

model AccessPolicyAssignment {
  id       String @id @default(cuid())
  userId   String
  policyId String

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  policy AccessPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([userId, policyId])
}

// ─── Settings & Feature Toggles ──────────────────────────────────

model AppSettings {
  id                      String   @id @default("default")
  conferenceName          String   @default("Conference")
  hotelSoloNightLimit     Int      @default(0)
  hotelRoommateNightLimit Int      @default(0)
  smtpHost                String?
  smtpPort                Int      @default(587)
  smtpUser                String?
  smtpPassword            String?
  smtpFrom                String?
  smtpSecure              Boolean  @default(false)
  globalFeatures          Json     @default("{}")
  updatedAt               DateTime @updatedAt
}

// ─── Departments ─────────────────────────────────────────────────

model Department {
  id                  String   @id @default(cuid())
  name                String   @unique
  description         String?
  color               String   @default("#6366f1")
  isOrderingDept      Boolean  @default(false)
  helpdeskQueueAccess Boolean  @default(false)
  features            Json     @default("{}")
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  members         DepartmentMember[]
  invites         Invite[]
  todos           Todo[]
  communications  Communication[]
  tickets         HelpdeskTicket[]
  calendarEvents  CalendarEvent[]
  documents       Document[]
  surveys         Survey[]
  handoverNotes   HandoverNote[]
  shifts          Shift[]
  inventoryItems  InventoryItem[]
  ordersRequested ItemOrder[]        @relation("OrderFromDept")
  ordersFulfilled ItemOrder[]        @relation("OrderToDept")
  budgetEntries   BudgetEntry[]
  orgNodes        OrgChartNode[]
  radioChannels   RadioChannel[]
  onCallSlots     OnCallSlot[]
  runOfShowItems  RunOfShowItem[]
  mediaItems      MediaItem[]
  vendors         Vendor[]
  mealPlans       MealPlan[]
  publishedSchedules PublishedSchedule[]
  loadScheduleTasks  LoadScheduleTask[]
}

model DepartmentMember {
  id           String   @id @default(cuid())
  departmentId String
  userId       String
  isLead       Boolean  @default(false)
  createdAt    DateTime @default(now())

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([departmentId, userId])
  @@index([userId])
}

// ─── Todos ───────────────────────────────────────────────────────

enum TodoStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TodoPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Todo {
  id           String       @id @default(cuid())
  title        String
  description  String?
  status       TodoStatus   @default(OPEN)
  priority     TodoPriority @default(MEDIUM)
  dueAt        DateTime?
  departmentId String?
  createdById  String
  assigneeId   String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  department Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdBy  User        @relation("TodosCreated", fields: [createdById], references: [id], onDelete: Cascade)
  assignee   User?       @relation("TodosAssigned", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([departmentId])
  @@index([assigneeId])
  @@index([status])
}

// ─── Communications (SMS-ready model) ────────────────────────────

enum CommPriority {
  NORMAL
  CRITICAL
}

enum CommChannel {
  IN_APP
  EMAIL
  SMS // reserved for future gateway
}

model Communication {
  id              String       @id @default(cuid())
  subject         String
  body            String
  departmentId    String?
  authorId        String
  recipientIds    String[] // specific people; empty + department = whole dept
  targetRoles     SystemRole[] // optional role targeting
  priority        CommPriority @default(NORMAL)
  channels        CommChannel[] @default([IN_APP])
  requiresAck     Boolean      @default(false)
  isPinned        Boolean      @default(false)
  // Future SMS gateway fields
  smsProviderId   String?
  smsPayload      Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  department Department?         @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  author     User                @relation("CommsSent", fields: [authorId], references: [id], onDelete: Cascade)
  reads      CommunicationRead[]

  @@index([departmentId])
  @@index([authorId])
  @@index([priority])
}

model CommunicationRead {
  id              String    @id @default(cuid())
  communicationId String
  userId          String
  readAt          DateTime  @default(now())
  acknowledgedAt  DateTime?

  communication Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communicationId, userId])
}

// ─── Helpdesk + Incident ─────────────────────────────────────────

enum TicketSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

model HelpdeskTicket {
  id            String         @id @default(cuid())
  title         String
  description   String
  severity      TicketSeverity @default(MEDIUM)
  status        TicketStatus   @default(OPEN)
  departmentId  String
  createdById   String
  assigneeId    String?
  escalatedToId String?
  isIncident    Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  resolvedAt    DateTime?

  department Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdBy  User              @relation("TicketsCreated", fields: [createdById], references: [id], onDelete: Cascade)
  assignee   User?             @relation("TicketsAssigned", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments   HelpdeskComment[]

  @@index([departmentId])
  @@index([status])
  @@index([severity])
  @@index([isIncident])
}

model HelpdeskComment {
  id         String   @id @default(cuid())
  ticketId   String
  authorId   String
  body       String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  ticket HelpdeskTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User           @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

// ─── Calendar & Published Schedules ──────────────────────────────

model CalendarEvent {
  id           String   @id @default(cuid())
  title        String
  description  String?
  location     String?
  startsAt     DateTime
  endsAt       DateTime
  allDay       Boolean  @default(false)
  isMaster     Boolean  @default(false)
  isPublished  Boolean  @default(false)
  color        String?
  departmentId String?
  ownerId      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department   Department?     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  owner        User            @relation("EventsOwned", fields: [ownerId], references: [id], onDelete: Cascade)
  runOfShow    RunOfShowItem[]

  @@index([startsAt, endsAt])
  @@index([departmentId])
  @@index([ownerId])
  @@index([isMaster])
  @@index([isPublished])
}

enum OverlayStatus {
  PENDING
  APPROVED
  DENIED
}

model CalendarOverlayRequest {
  id          String        @id @default(cuid())
  requesterId String
  targetId    String
  status      OverlayStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  requester User @relation("OverlayRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  target    User @relation("OverlayTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([requesterId, targetId])
}

model PublishedSchedule {
  id           String   @id @default(cuid())
  title        String
  departmentId String?
  icalBody     String
  publishedAt  DateTime @default(now())
  createdById  String?

  department Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([departmentId])
}

// ─── Documents ───────────────────────────────────────────────────

enum DocumentSource {
  LOCAL
  EXTERNAL
}

model Document {
  id           String         @id @default(cuid())
  title        String
  description  String?
  departmentId String?
  source       DocumentSource @default(LOCAL)
  currentUrl   String?
  currentPath  String?
  mimeType     String?
  sizeBytes    Int?
  uploadedById String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  department Department?        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  uploadedBy User               @relation("DocsUploaded", fields: [uploadedById], references: [id], onDelete: Cascade)
  revisions  DocumentRevision[]

  @@index([departmentId])
}

model DocumentRevision {
  id          String         @id @default(cuid())
  documentId  String
  version     Int
  source      DocumentSource
  url         String?
  filePath    String?
  mimeType    String?
  sizeBytes   Int?
  notes       String?
  createdById String
  createdAt   DateTime       @default(now())

  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([documentId])
}

// ─── Surveys (Google Forms-like) ─────────────────────────────────

model Survey {
  id           String   @id @default(cuid())
  title        String
  description  String?
  departmentId String?
  // [{id, type: text|textarea|single|multi|scale|date, label, required, options?}]
  questions    Json
  isOpen       Boolean  @default(true)
  isTemplate   Boolean  @default(false)
  templateKey  String? // e.g. after_action
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department?      @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdBy  User             @relation(fields: [createdById], references: [id], onDelete: Cascade)
  responses  SurveyResponse[]
}

model SurveyResponse {
  id        String   @id @default(cuid())
  surveyId  String
  userId    String?
  // allow anonymous kiosk responses
  responder String?
  answers   Json
  createdAt DateTime @default(now())

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([surveyId])
}

// ─── Handover Notes ──────────────────────────────────────────────

model HandoverNote {
  id           String   @id @default(cuid())
  departmentId String
  authorId     String
  title        String
  body         String
  shiftLabel   String?
  forDate      DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  author     User       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([departmentId])
}

// ─── Shifts ──────────────────────────────────────────────────────

model Shift {
  id             String   @id @default(cuid())
  departmentId   String
  title          String
  description    String?
  startsAt       DateTime
  endsAt         DateTime
  location       String?
  slots          Int      @default(1)
  allowSelfSignup Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  department  Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  assignments ShiftAssignment[]

  @@index([departmentId])
  @@index([startsAt])
}

model ShiftAssignment {
  id        String   @id @default(cuid())
  shiftId   String
  userId    String
  notes     String?
  createdAt DateTime @default(now())

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shiftId, userId])
}

// ─── Inventory / Asset Tracking ──────────────────────────────────

enum InventoryStatus {
  AVAILABLE
  CHECKED_OUT
  MAINTENANCE
  LOST
}

model InventoryItem {
  id              String          @id @default(cuid())
  departmentId    String?
  name            String
  description     String?
  serialNumber    String?
  category        String?
  status          InventoryStatus @default(AVAILABLE)
  location        String?
  assetCode       String          @unique // QR/barcode payload
  quantity        Int             @default(1) // usually 1 for tracked assets
  lowStockThreshold Int?
  checkedOutToId  String?
  checkedOutAt    DateTime?
  expectedReturnAt DateTime?
  checkoutNotes   String?
  sourceOrderId   String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  department   Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  checkedOutTo User?            @relation("CheckedOutTo", fields: [checkedOutToId], references: [id], onDelete: SetNull)
  events       InventoryEvent[]

  @@index([departmentId])
  @@index([status])
  @@index([category])
  @@index([name])
}

enum InventoryEventType {
  CREATED
  UPDATED
  CHECK_OUT
  CHECK_IN
  MAINTENANCE
  LOST
  FOUND
  STOCK_ADJUST
  RECEIVED_FROM_ORDER
}

model InventoryEvent {
  id        String             @id @default(cuid())
  itemId    String
  actorId   String
  type      InventoryEventType
  notes     String?
  meta      Json?
  createdAt DateTime           @default(now())

  item  InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  actor User          @relation("InventoryActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([type])
  @@index([createdAt])
}

// ─── Item Orders ─────────────────────────────────────────────────

enum OrderStatus {
  REQUESTED
  APPROVED
  FULFILLED
  DENIED
  CANCELLED
}

model ItemOrder {
  id            String      @id @default(cuid())
  title         String
  description   String?
  quantity      Int         @default(1)
  status        OrderStatus @default(REQUESTED)
  fromDeptId    String?
  toDeptId      String?
  requestedById String
  fulfilledById String?
  receivedToInventory Boolean @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  fromDept    Department? @relation("OrderFromDept", fields: [fromDeptId], references: [id], onDelete: SetNull)
  toDept      Department? @relation("OrderToDept", fields: [toDeptId], references: [id], onDelete: SetNull)
  requestedBy User        @relation("OrdersRequested", fields: [requestedById], references: [id], onDelete: Cascade)
  fulfilledBy User?       @relation("OrdersFulfilled", fields: [fulfilledById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([toDeptId])
}

// ─── Budget (approval workflow) ──────────────────────────────────

enum BudgetStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

model BudgetEntry {
  id            String       @id @default(cuid())
  departmentId  String?
  label         String
  amount        Decimal      @db.Decimal(12, 2)
  category      String?
  notes         String?
  status        BudgetStatus @default(PENDING)
  incurredAt    DateTime     @default(now())
  createdById   String
  approvedById  String?
  approvedAt    DateTime?
  createdAt     DateTime     @default(now())

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdBy  User        @relation("BudgetCreated", fields: [createdById], references: [id], onDelete: Cascade)
  approvedBy User?       @relation("BudgetApproved", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([departmentId])
  @@index([status])
}

// ─── Lost & Found ────────────────────────────────────────────────

enum LostFoundStatus {
  LOST
  FOUND
  CLAIMED
  DISPOSED
}

model LostFoundItem {
  id           String          @id @default(cuid())
  title        String
  description  String?
  location     String?
  status       LostFoundStatus @default(FOUND)
  reportedById String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  reportedBy User @relation(fields: [reportedById], references: [id], onDelete: Cascade)
}

// ─── Media Gallery ───────────────────────────────────────────────

model MediaItem {
  id           String   @id @default(cuid())
  title        String
  description  String?
  url          String?
  filePath     String?
  mimeType     String?
  tags         String[]
  departmentId String?
  eventLabel   String?
  uploadedById String
  createdAt    DateTime @default(now())

  uploadedBy User        @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
}

// ─── Con Bible ───────────────────────────────────────────────────

model ConBiblePage {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  body        String
  category    String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  authorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

// ─── Org Chart ───────────────────────────────────────────────────

model OrgChartNode {
  id           String  @id @default(cuid())
  title        String
  userId       String?
  departmentId String?
  parentId     String?
  sortOrder    Int     @default(0)

  user       User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  department Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  parent     OrgChartNode?  @relation("OrgTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   OrgChartNode[] @relation("OrgTree")
}

// ─── Badge System ────────────────────────────────────────────────

model BadgeType {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  color       String  @default("#0ea5e9")
  accessLevel String?

  assignments BadgeAssignment[]
}

model BadgeAssignment {
  id          String   @id @default(cuid())
  badgeTypeId String
  userId      String
  notes       String?
  badgeCode   String   @unique @default(cuid())
  createdAt   DateTime @default(now())

  badgeType BadgeType @relation(fields: [badgeTypeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([badgeTypeId, userId])
}

// ─── Radio Channels ──────────────────────────────────────────────

model RadioChannel {
  id           String  @id @default(cuid())
  name         String
  frequency    String?
  description  String?
  departmentId String?

  department  Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignments RadioAssignment[]
}

model RadioAssignment {
  id        String   @id @default(cuid())
  channelId String
  userId    String
  callSign  String?
  createdAt DateTime @default(now())

  channel RadioChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
}

// ─── On-Call Roster ──────────────────────────────────────────────

model OnCallSlot {
  id           String   @id @default(cuid())
  departmentId String?
  userId       String
  startsAt     DateTime
  endsAt       DateTime
  notes        String?
  contactPhone String?
  createdAt    DateTime @default(now())

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([startsAt, endsAt])
}

// ─── Room Booking ────────────────────────────────────────────────

enum RoomBookingStatus {
  REQUESTED
  APPROVED
  DENIED
  CANCELLED
}

model Room {
  id       String  @id @default(cuid())
  name     String  @unique
  capacity Int?
  location String?
  notes    String?

  bookings RoomBooking[]
}

model RoomBooking {
  id        String            @id @default(cuid())
  roomId    String
  userId    String
  title     String
  startsAt  DateTime
  endsAt    DateTime
  status    RoomBookingStatus @default(REQUESTED)
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId, startsAt, endsAt])
}

// ─── Load In / Load Out Schedule ─────────────────────────────────

enum LoadPhase {
  LOAD_IN
  LOAD_OUT
}

enum LoadTaskStatus {
  PLANNED
  IN_PROGRESS
  DONE
  BLOCKED
  CANCELLED
}

model LoadScheduleTask {
  id           String         @id @default(cuid())
  departmentId String
  phase        LoadPhase
  title        String
  description  String?
  location     String?
  startsAt     DateTime
  endsAt       DateTime
  status       LoadTaskStatus @default(PLANNED)
  sortOrder    Int            @default(0)
  createdById  String
  assigneeId   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdBy  User       @relation("LoadTasksCreated", fields: [createdById], references: [id], onDelete: Cascade)
  assignee   User?      @relation("LoadTasksAssigned", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([departmentId, phase])
  @@index([startsAt, endsAt])
  @@index([phase, startsAt])
  @@index([status])
}

// ─── Run of Show ─────────────────────────────────────────────────

model RunOfShowItem {
  id             String    @id @default(cuid())
  departmentId   String?
  calendarEventId String?
  title          String
  description    String?
  startsAt       DateTime
  endsAt         DateTime?
  location       String?
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  department    Department?    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  calendarEvent CalendarEvent? @relation(fields: [calendarEventId], references: [id], onDelete: SetNull)

  @@index([startsAt])
  @@index([calendarEventId])
}

// ─── Vendors / Exhibitors ────────────────────────────────────────

model Vendor {
  id           String   @id @default(cuid())
  name         String
  contactName  String?
  contactEmail String?
  contactPhone String?
  booth        String?
  notes        String?
  departmentId String?
  contactUserId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department  Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  contactUser User?       @relation("VendorContact", fields: [contactUserId], references: [id], onDelete: SetNull)
}

// ─── Meals / Dietary ─────────────────────────────────────────────

model MealPlan {
  id           String   @id @default(cuid())
  name         String
  mealDate     DateTime
  departmentId String?
  notes        String?
  createdAt    DateTime @default(now())

  department Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  selections MealSelection[]
}

model MealSelection {
  id          String  @id @default(cuid())
  mealPlanId  String
  userId      String
  choice      String?
  dietaryNote String?

  mealPlan MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([mealPlanId, userId])
}

// ─── Staff / Volunteer Check-in Kiosk ────────────────────────────

model StaffCheckIn {
  id         String    @id @default(cuid())
  userId     String
  checkedInAt DateTime @default(now())
  checkedOutAt DateTime?
  method     String    @default("kiosk") // kiosk | badge_scan | manual
  notes      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([checkedInAt])
}

// ─── Audit Log ───────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String?
  entityId   String?
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ─── Notifications ───────────────────────────────────────────────

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}
