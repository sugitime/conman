# ── Application ──────────────────────────────────────────
NODE_ENV=development
APP_NAME=ConMan
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ── Database ─────────────────────────────────────────────
POSTGRES_USER=conman
POSTGRES_PASSWORD=conman
POSTGRES_DB=conman
# Inside Docker Compose use host "db"; for local API use "localhost"
DATABASE_URL=postgresql://conman:conman@db:5432/conman?schema=public

# ── Auth ─────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Seed admin (first boot) ──────────────────────────────
SEED_ADMIN_EMAIL=admin@conman.local
SEED_ADMIN_PASSWORD=changeme123
SEED_ADMIN_NAME=Con Manager

# ── Uploads ──────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=25

# ── Optional Redis ───────────────────────────────────────
REDIS_URL=

# ── Optional SMTP defaults (prefer Admin → Settings UI) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=false

# ── Frontend build (Docker web image) ────────────────────
# Leave empty so the browser calls same-origin /api via nginx proxy
VITE_API_URL=
