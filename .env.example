# Application
NODE_ENV=development
APP_NAME=ConMan
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:5173

# Database
POSTGRES_USER=conman
POSTGRES_PASSWORD=conman
POSTGRES_DB=conman
DATABASE_URL=postgresql://conman:conman@db:5432/conman?schema=public

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Seed admin (first boot)
SEED_ADMIN_EMAIL=admin@conman.local
SEED_ADMIN_PASSWORD=changeme123
SEED_ADMIN_NAME=Con Manager

# File uploads
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=25

# Redis (optional)
REDIS_URL=redis://redis:6379

# SMTP defaults (overridable in app settings UI)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=false
